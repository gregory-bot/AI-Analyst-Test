# Backend configuration - this file is git-ignored; never commit real keys.
# Get a key at https://platform.openai.com/api-keys (the account needs billing credit).
OPENAI_API_KEY=
# Model used for extraction (must support PDF input + structured outputs)
OPENAI_MODEL=gpt-5.5
# Reasoning effort for GPT-5 / o-series models: low | medium | high
OPENAI_REASONING_EFFORT=medium
# Comma-separated origins allowed to call the API (the React dev server by default)
ALLOWED_ORIGINS=http://localhost:5173
